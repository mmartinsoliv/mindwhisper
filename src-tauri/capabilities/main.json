{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window only: hide itself (History reinsert) and manage autostart",
  "windows": ["main"],
  "permissions": ["core:window:allow-hide", "autostart:allow-enable", "autostart:allow-disable", "autostart:allow-is-enabled"]
}
